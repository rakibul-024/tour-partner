[{"id":"cox-s-bazar","name":"Cox's Bazar","district":"Cox's Bazar","category":"Beach","description":"Follow the curve of the world's longest natural sea beach, where golden sand, fishing boats and a wide-open horizon set an easy pace.","specialty":"A 120 km stretch of unbroken shoreline","rating":4.9,"reviews":2840,"bestSeason":"November – February","budget":"৳3,000–6,000 / day","tags":["Sea views","Local seafood","Sunset"],"activities":["Beach walks","Surfing","Seafood tasting","Sunset watching"],"images":[{"src":"/images/cox-bazar.jpg","alt":"Golden-hour light over Cox's Bazar sea beach","attribution":"Tanweer Morshed","license":"CC BY-SA 3.0","source":"https://commons.wikimedia.org/wiki/File:Cox%27s_Bazar_sea_beach_01.jpg"}],"coordinates":{"lat":21.4272,"lng":92.0058},"transit":{"Bus":"Frequent overnight and daytime coaches run from Dhaka to Cox's Bazar.","Train":"Take a train to Chattogram, then continue by road to the coast.","Flight":"Domestic flights connect Dhaka with Cox's Bazar Airport."},"keywords":["sea","coast","beach","ocean"]},{"id":"sajek-valley","name":"Sajek Valley","district":"Rangamati","category":"Hill","description":"Wake above a sea of clouds in the Chittagong Hill Tracts, where quiet ridgelines and small hillside communities reward a slower journey.","specialty":"Cloud-wrapped hilltop sunrises","rating":4.8,"reviews":1920,"bestSeason":"October – April","budget":"৳4,000–7,000 / day","tags":["Clouds","Hilltop stays","Sunrise"],"activities":["Sunrise viewpoints","Hill trekking","Village visits","Photography"],"images":[{"src":"/images/sajek-valley.jpg","alt":"A view across the hills of Sajek Valley","attribution":"Thenameissayem","license":"CC BY-SA 4.0","source":"https://commons.wikimedia.org/wiki/File:Sajek_Valley_20190818.jpg"}],"coordinates":{"lat":23.3815,"lng":92.2938},"transit":{"Bus":"Travel to Khagrachari by bus; local shared vehicles continue to Sajek.","Train":"There is no direct train. Reach Chattogram by rail and continue by road.",