:24.8949,"lng":91.8687},"transit":{"Bus":"Direct coach services run from Dhaka to Sylhet throughout the day.","Train":"Intercity trains connect Dhaka and Sylhet; local transport reaches the estates.","Flight":"Daily domestic flights connect Dhaka with Osmani International Airport."},"keywords":["tea","garden","green","nature","hills"]},{"id":"sreemangal","name":"Sreemangal","district":"Moulvibazar","category":"Forest","description":"A gentle escape into tea country, with forest trails, rain-washed gardens and a famously unhurried small-town feel.","specialty":"Tea estates beside protected rainforest","rating":4.8,"reviews":940,"bestSeason":"October – March","budget":"৳2,000–4,500 / day","tags":["Rainforest","Tea trails","Birdlife"],"activities":["Forest trekking","Tea garden visits","Birdwatching","Cycling"],"images":[{"src":"/images/sreemangal.jpg","alt":"Tea gardens rolling over the hills of Sreemangal","attribution":"Radman Siddiki","license":"CC BY 4.0","source":"https://commons.wikimedia.org/wiki/File:Tea_Gardens_of_Sreemangal_01.jpg"}],"coordinates":{"lat":24.3065,"lng":91.7296},"transit":{"Bus":"Coaches to Sreemangal and nearby Moulvibazar run from Dhaka and Sylhet.","Train":"Intercity trains from Dhaka stop at Sreemangal station.","Flight":"Fly to Sylhet, then continue around 80 km by road."},"keywords":["tea","forest","nature","rainforest"]},{"id":"sonargaon","name":"Sonargaon","district":"Narayanganj","category":"Historical","description":"Step into Bengal's past among old merchant houses, riverside lanes and the restored timber architecture of Panam City.","specialty":"The atmospheric merchant street of Panam City","rating":4.6,"reviews":780,"bestSeason":"November – February","budget":"৳1,500–3,000 / day","tags":["Old town","Architecture","Heritage"],"activities":["Heritage walks","Museum visits","Architecture tours","Local crafts"],"images":[{"src":"/images/sonargaon.png","alt":"Historic merchant houses on the old street of Panam City","attribution":"K M Rabbani","license":"CC BY-SA 4.0","source":"https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcTOyLlkgAaUOW0_MLIXPL_arWxIIUJNCEbHsoJW8Cm1Hw&s=10"}],"coordinates":{"lat":23.6514,"lng":90.6078},"transit":{"Bus":"Local buses and rideshare services connect central Dhaka with Sonargaon.","Train":"Take a train to Dhaka, then continue by road to the historic town.","Flight":"Fly to Dhaka and travel onward by road."},"keywords":["history","heritage","architecture","old town"]},{"id":"tanguar-haor","name":"Tanguar Haor","district":"Sunamganj","category":"Wetland","description":"Sail across a shimmering freshwater haor, where floating villages and seasonal birdlife turn the horizon into open water.","specialty":"A vast Ramsar-listed freshwater wetland","rating":4.8,"reviews":620,"bestSeason":"June – September","budget":"৳3,000–6,000 / day","tags":["Open water","Boat journeys","Birdlife"],"activities":["Boat trips","Birdwatching","Village visits","Sunrise cruises"],"images":[{"src":"/images/tanguar-haor.jpg","alt":"Silhouettes of trees reflected in the wide water of Tanguar Haor","attribution":"Abdul Momin","license":"CC BY-SA 4.0","source":"https://commons.wikimedia.org/wiki/File:Tanguar_haor,_Bangladesh_01.jpg"}],"coordinates":{"lat":25.1175,"lng":91.0628},"transit":{"Bus":"Travel to Sunamganj by bus from Sylhet, then arrange local boat transport.","Train":"Take a train to Sylhet and continue to Sunamganj by road.","Flight":"Fly to Sylhet and travel onward by road to the haor."},"keywords":["wetland","haor","water","birdwatching","river"]},{"id":"lalbagh-fort","name":"Lalbagh Fort","district":"Dhaka","category":"Historical","description":"Find a moment of calm inside Old Dhaka's unfinished Mughal fortress, framed by graceful gardens and centuries-old brickwork.","specialty":"An unfinished 17th-century Mughal fort","rating":4.5,"reviews":1430,"bestSeason":"October – March","budget":"৳1,000–2,500 / day","tags":["Mughal history","Gardens","Old Dhaka"],"activities":["Fort tours","History walks","Garden visits","Street food"],"images":[{"src":"/images/lalbagh-fort.jpg","alt":"Brick gateway and gardens at Lalbagh Fort in Dhaka","attribution":"Shmunmun","license":"Public domain","source":"https://commons.wikimedia.org/wiki/File:Dhaka_Lalbagh_Fort_5.JPG"}],"coordinates":{"lat":23.7195,"lng":90.3888},"transit":{"Bus":"Local buses and rideshare services reach Old Dhaka from across the city.","Train":"Arrive at Dhaka railway station and continue by local transport.","Flight":"Fly to Hazrat Shahjalal International Airport; the fort is in central Dhaka."},"keywords":["history","fort","mughal","heritage","architecture"]}]